# Copia este archivo como ".env" (sin ".example") y completa con los datos
# de tu proyecto de Supabase: Project Settings → API.
#
# VITE_SUPABASE_URL es la URL de tu proyecto (algo como https://xxxx.supabase.co)
# VITE_SUPABASE_ANON_KEY es la clave PÚBLICA (anon/public) — no la "service_role".
# La anon key es segura de exponer en el frontend: Row Level Security en la
# base de datos es lo que realmente protege los datos, no el secreto de esta clave.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica
